{
    "name": "clothing-ecommerce/backend",
    "description": "PHP Slim backend for clothing e-commerce platform",
    "type": "project",
    "license": "MIT",
    "require": {
        "php": "^8.2",
        "slim/slim": "^4.12",
        "slim/psr7": "^1.6",
        "php-di/php-di": "^7.0",
        "monolog/monolog": "^3.4",
        "firebase/php-jwt": "^6.8",
        "respect/validation": "^2.2",
        "vlucas/phpdotenv": "^5.5",
        "tuupola/cors-middleware": "^1.4",
        "selective/basepath": "^2.1"
    },
    "require-dev": {
        "phpunit/phpunit": "^10.3",
        "pestphp/pest": "^2.17",
        "phpstan/phpstan": "^1.10",
        "squizlabs/php_codesniffer": "^3.7"
    },
    "autoload": {
        "psr-4": {
            "App\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Tests\\": "tests/"
        }
    },
    "scripts": {
        "test": "pest",
        "test-coverage": "pest --coverage",
        "phpstan": "phpstan analyse src --level=8",
        "cs-check": "phpcs src --standard=PSR12",
        "cs-fix": "phpcbf src --standard=PSR12",
        "serve": "php -S localhost:8000 -t public"
    },
    "config": {
        "optimize-autoloader": true,
        "sort-packages": true
    },
    "minimum-stability": "stable",
    "prefer-stable": true
}
